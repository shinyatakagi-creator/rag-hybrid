OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBED_MODEL=text-embedding-3-small
ANSWER_MODEL=claude-sonnet-5-5
VERIFIER_MODEL=claude-haiku-5-5
ES_URL=http://127.0.0.1:9200
ES_INDEX=rag-docs
MAX_SPEND_USD=5

# Optional host ports (both are published on 127.0.0.1 only). Change ES_HOST_PORT if something else already uses 9200,
# and then also change the port in ES_URL above, because the host-side scripts use ES_URL.
# ES_HOST_PORT=9200
# API_HOST_PORT=8000
